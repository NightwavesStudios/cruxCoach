---
import BaseLayout from "./BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle";
import "../styles/app.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Your CruxCoach climbing logbook." } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const items = [
  {
    href: "/app",
    label: "Logbook",
    icon: "M4 4h6v7H4V4Zm10 0h6v4h-6V4ZM4 13h6v7H4v-7Zm10-3h6v10h-6V10Z",
  },
  {
    href: "/app/log",
    label: "Log session",
    icon: "M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7V4Z",
  },
  {
    href: "/app/patterns",
    label: "Patterns",
    icon: "M4 20V10h3v10H4Zm6 0V4h3v16h-3Zm6 0v-7h3v7h-3Z",
  },
  {
    href: "/app/journal",
    label: "Journal",
    icon: "M5 3h11a3 3 0 0 1 3 3v15H8a3 3 0 0 1-3-3V3Zm3 3v2h8V6H8Zm0 4v2h8v-2H8Z",
  },
  {
    href: "/app/plans",
    label: "Training plans",
    icon: "M7 2h2v2h6V2h2v2h3a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3V2Zm13 8H4v10h16V10Z",
  },
  {
    href: "/app/train",
    label: "Train",
    icon: "M4 9h2V7h2v10H6v-2H4V9Zm14 0h2v6h-2v2h-2V7h2v2ZM9 11h6v2H9v-2Z",
  },
  {
    href: "/app/learn",
    label: "Learn",
    icon: "M12 3 1 9l11 6 8-4.36V17h2V9L12 3Zm-6 9.2V17l6 3 6-3v-4.8l-6 3.27-6-3.27Z",
  },
];

const tabs = [
  items[0],
  items[1],
  items[2],
  items[3],
];
---

<BaseLayout title={title} description={description} noindex>
  <header class="app-header">
    <div class="app-header-inner">
      <a class="app-brand" href="/app">
        <svg class="brand-mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M2 19 9 5l4 8 3-5 6 11" fill="none" stroke="currentColor" stroke-width="1.7" />
        </svg>
        <span>CruxCoach</span>
      </a>

      <div class="app-header-actions">
        <a class="app-back" href="/">Back to site</a>
        <a class="btn btn-primary app-log-btn" href="/app/log">Log session</a>
        <ThemeToggle client:load />
        <a class="app-avatar" href="/app/profile" aria-label="Open profile">CC</a>
      </div>
    </div>
  </header>

  <div class="app-layout">
    <aside class="app-sidebar">
      <nav aria-label="Sections">
        {
          items.map((item) => (
            <a
              class:list={["app-nav-link", { active: path === item.href }]}
              href={item.href}
              aria-current={path === item.href ? "page" : undefined}
            >
              <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
                <path fill="currentColor" d={item.icon} />
              </svg>
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>

      <div class="app-note">
        <strong>On this device</strong>
        <p>Your logbook stays in this browser. Export a backup from your profile whenever you want one.</p>
      </div>
    </aside>

    <main class="app-main">
      <slot />
    </main>
  </div>

  <nav class="app-tabbar" aria-label="Quick navigation">
    {
      tabs.map((tab) => (
        <a
          class:list={["app-tab", { active: path === tab.href }]}
          href={tab.href}
          aria-current={path === tab.href ? "page" : undefined}
        >
          <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true">
            <path fill="currentColor" d={tab.icon} />
          </svg>
          <span>{tab.label}</span>
        </a>
      ))
    }
  </nav>
</BaseLayout>
