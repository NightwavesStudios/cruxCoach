---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import FeatureRow from "../components/FeatureRow.astro";

const features = [
  {
    eyebrow: "Reflect",
    title: "Score what felt hard.",
    body: "Rate holds, wall angles and styles after a session. Recent reflections count for more, so the picture follows you as you improve.",
    image: "/images/reflect.webp",
    alt: "CruxCoach session reflection screen with scores for holds, angles and styles",
  },
  {
    eyebrow: "Patterns",
    title: "See what separates indoor from outdoor.",
    body: "Send rate, hardest grade, session length and effort, counted indoors and outdoors on their own terms. The comparison shows which habits travel to the crag.",
    image: "/images/analytics.webp",
    alt: "CruxCoach patterns screen comparing indoor and outdoor climbing",
  },
  {
    eyebrow: "Log",
    title: "Log the session while it is fresh.",
    body: "Record where you climbed, the discipline, each grade and how many attempts it took. Every session feeds the journal and the patterns.",
    image: "/images/log.webp",
    alt: "CruxCoach session logging form",
  },
  {
    eyebrow: "Plans",
    title: "Plan the next block.",
    body: "Pick a discipline, a venue, a target grade and the days you can climb. CruxCoach fills in a 2 to 8 week schedule.",
    image: "/images/plans.webp",
    alt: "CruxCoach training plan screen",
  },
  {
    eyebrow: "Journal",
    title: "Every session, in order.",
    body: "Every session and reflection in one timeline, filterable by indoor, outdoor or training. Old notes stay searchable.",
    image: "/images/journal.webp",
    alt: "CruxCoach journal with past sessions and reflections",
  },
  {
    eyebrow: "Library",
    title: "Read up on the holds that trouble you.",
    body: "Practical lessons and drills for crimps, slopers, overhangs and endurance, recommended from your reflection scores.",
    image: "/images/content.webp",
    alt: "CruxCoach lesson and workout library",
  },
];

const checks = [
  "No subscriptions or paywalls",
  "No account and no trial period",
  "Your data stays on your device",
];
---

<BaseLayout
  title="CruxCoach: a climbing logbook that reads patterns"
  description="A free climbing logbook for indoor and outdoor sessions. Track grades, attempts and reflections, then compare how you climb in the gym and at the crag."
>
  <SiteHeader />

  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Climbing logbook</p>
          <h1>Log the session.<br /><span>See the pattern.</span></h1>
          <p class="lede">
            Indoor and outdoor climbing kept apart, then read together. Grades, attempts and
            reflections become patterns you can train against.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/app">
              Open the logbook
            </a>
            <a class="btn btn-secondary" href="#features">What is inside</a>
          </div>
          <ul class="hero-points">
            <li>No account</li>
            <li>Works offline</li>
            <li>Free to use</li>
          </ul>
        </div>

        <figure class="hero-plate">
          <img
            src="/images/analytics.webp"
            alt="CruxCoach patterns screen with indoor and outdoor totals"
            width="1400"
            height="900"
            fetchpriority="high"
          />
          <figcaption>
            <span>Fig. 1</span>
            Indoor and outdoor totals, side by side, from your own sessions.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="features" id="features">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">What is inside</p>
          <h2>What the log gives back.</h2>
          <p>
            CruxCoach connects what you climb, how it felt and what to train next, without
            stitching together five apps and a paper notebook.
          </p>
        </header>

        <div class="feature-list">
          {features.map((feature, index) => (
            <FeatureRow {...feature} reverse={index % 2 === 1} />
          ))}
        </div>
      </div>
    </section>

    <section class="pricing" id="pricing">
      <div class="container">
        <div class="pricing-card">
          <div class="pricing-copy">
            <p class="eyebrow">Pricing</p>
            <h2>Free, no account.</h2>
            <p>
              No subscriptions and no paywalls. Everything runs in your browser and your data
              stays there. Export a backup whenever you want one.
            </p>
            <a class="btn btn-primary" href="/app">Start a logbook</a>
          </div>
          <ul class="checks">
            {checks.map((check) => (
              <li>
                <span class="check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="13" height="13">
                    <path fill="currentColor" d="M9.6 16.6 5 12l-1.4 1.4 6 6 12-12L20.2 6 9.6 16.6Z" />
                  </svg>
                </span>
                {check}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="about" id="about">
      <div class="container about-grid">
        <p class="eyebrow">About</p>
        <div>
          <h2>One place for the whole log.</h2>
          <p>
            CruxCoach started because no single app covered climbing journaling, patterns and
            training without a monthly fee. This is that app: the whole log, from a first
            session to a long-running project.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <a class="brand" href="/">
        <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true">
          <path d="M2 19 9 5l4 8 3-5 6 11" fill="none" stroke="currentColor" stroke-width="1.7" />
        </svg>
        <span>CruxCoach</span>
      </a>
      <p>© {new Date().getFullYear()} CruxCoach. Your logbook stays in your browser.</p>
      <a href="/app">Open logbook</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  h1 {
    margin-top: var(--space-4);
    font-size: var(--step-5);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  h1 span {
    display: inline-block;
    padding-bottom: 0.05em;
    border-bottom: 3px solid var(--accent);
  }

  .lede {
    margin-top: var(--space-4);
    max-width: 40ch;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero-points {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .hero-points li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero-points li::before {
    content: "";
    width: 0.3rem;
    height: 0.3rem;
    background: var(--accent);
  }

  .hero-plate {
    margin: 0;
  }

  .hero-plate img {
    width: 100%;
    height: auto;
    border: 1px solid var(--ink);
    aspect-ratio: 1400 / 900;
    object-fit: cover;
    object-position: top;
    background: var(--surface);
  }

  .hero-plate figcaption {
    display: flex;
    gap: var(--space-3);
    margin-top: 0.7rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.76rem;
    color: var(--ink-3);
  }

  .hero-plate figcaption span {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .features {
    padding-block: var(--space-12);
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .section-head {
    max-width: 44rem;
    margin-bottom: var(--space-6);
  }

  .section-head h2 {
    margin-top: var(--space-3);
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
  }

  .section-head p:last-child {
    margin-top: var(--space-3);
    color: var(--ink-2);
  }

  .feature-list {
    display: grid;
  }

  .pricing {
    padding-block: var(--space-12);
  }

  .pricing-card {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: var(--space-8);
    align-items: center;
    padding: clamp(2rem, 5vw, 3.5rem);
    background: var(--ink);
    color: #eee7d7;
  }

  .pricing-card h2 {
    margin-top: var(--space-3);
    font-size: clamp(2rem, 4vw, 2.9rem);
    color: #faf5e9;
  }

  .pricing-card p {
    margin-top: var(--space-3);
    max-width: 52ch;
    color: #c8bfad;
  }

  .pricing-card .eyebrow {
    color: #e0a179;
  }

  .pricing-card .btn {
    margin-top: var(--space-5);
    background: #f3ecdc;
    border-color: #f3ecdc;
    color: #1d1b15;
  }

  .pricing-card .btn:hover {
    background: #e0a179;
    border-color: #e0a179;
  }

  .checks {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .checks li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: 0.6rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 18%);
    font-size: 0.9rem;
  }

  .check {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.1rem;
    border: 1px solid #e0a179;
    color: #e0a179;
  }

  .about {
    padding-block: var(--space-10) var(--space-12);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.5fr 1.5fr;
    gap: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--ink);
  }

  .about-grid h2 {
    font-size: var(--step-3);
  }

  .about-grid p:last-child {
    margin-top: var(--space-3);
    max-width: 64ch;
    color: var(--ink-2);
  }

  .footer {
    padding-block: var(--space-5);
    border-top: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--ink);
  }

  .brand svg {
    flex: none;
    color: var(--accent);
  }

  .footer p {
    margin-right: auto;
  }

  .footer > .container > a:last-child {
    color: var(--ink-2);
  }

  .footer > .container > a:last-child:hover {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-plate {
      max-width: 40rem;
    }

    .pricing-card {
      grid-template-columns: 1fr;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  @media (max-width: 560px) {
    .footer p {
      order: 3;
      width: 100%;
    }
  }
</style>
