---
import AppLayout from "../../layouts/AppLayout.astro";
import JournalView from "../../components/app/JournalView";
---

<AppLayout title="Journal | CruxCoach">
  <header class="page-head">
    <div>
      <p class="page-kicker">History</p>
      <h1>Journal</h1>
      <p class="page-sub">Every session and reflection, newest first. Filter indoor and outdoor days apart.</p>
    </div>
    <div class="page-actions">
      <a class="btn btn-secondary" href="/app/reflect">Reflect</a>
      <a class="btn btn-primary" href="/app/log">Log a session</a>
    </div>
  </header>

  <JournalView client:only="react" />
</AppLayout>
