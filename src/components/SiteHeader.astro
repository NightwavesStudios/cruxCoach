---
import ThemeToggle from "./ThemeToggle";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path d="M2 19 9 5l4 8 3-5 6 11" fill="none" stroke="currentColor" stroke-width="1.7" />
      </svg>
      <span>CruxCoach</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <a href="#features">Features</a>
      <a href="#pricing">Pricing</a>
      <a href="#about">About</a>
    </nav>

    <div class="header-actions">
      <ThemeToggle client:load />
      <a class="btn btn-primary btn-sm" href="/app">Open dashboard</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    display: flex;
    align-items: center;
    background: var(--bg);
    border-bottom: 1px solid var(--ink);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    margin-right: auto;
  }

  .brand svg {
    flex: none;
    color: var(--accent);
  }

  .site-nav {
    display: flex;
    gap: var(--space-5);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .site-nav a:hover {
    color: var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .btn-sm {
    min-height: 2.2rem;
    padding-inline: var(--space-3);
    font-size: 0.68rem;
  }

  @media (max-width: 860px) {
    .site-nav {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .header-actions .btn {
      display: none;
    }
  }
</style>
